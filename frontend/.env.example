# frontend/.env.example — copy to frontend/.env for local dev.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
# NEVER put secrets here — anything VITE_* is shipped to the client.

# API base URL. In dev, leave as /api to use the Vite proxy (vite.config.js).
VITE_API_URL=/api

# Optional: override the dev proxy target (defaults to http://localhost:5000).
# VITE_DEV_API=http://localhost:5000
