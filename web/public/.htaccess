# forgeVidhya — Apache configuration for the built single-page app.
#
# This file belongs in the same directory as index.html (on cPanel that is
# public_html). Without it Apache has no instruction to hand client-side
# routes to the app shell, so every URL but "/" returns 404 — and with no
# index file at all it returns 403 Forbidden for the document root.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A real file or directory is served as itself — assets, images, fonts.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a route the router owns (/blog/<slug>, /services, …),
  # so Apache hands over the app shell and React resolves it.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Matches the headers render.yaml sets, so both hosts behave alike.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The shell must never be cached. Its asset filenames change every build,
  # and a cached shell would keep asking for files that no longer exist.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Asset filenames carry a content hash, so they can be cached hard.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json image/svg+xml
</IfModule>

AddType image/svg+xml .svg
AddType font/woff2    .woff2
