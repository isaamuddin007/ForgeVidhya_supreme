# forgeVidhya — Apache configuration for the built single-page app.
#
# This file belongs in the same directory as index.html (on cPanel that is
# public_html). Without it Apache has no instruction to hand client-side
# routes to the app shell, so every URL but "/" returns 404 — and with no
# index file at all it returns 403 Forbidden for the document root.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A real file or directory is served as itself — assets, images, fonts.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a route the router owns (/blog/<slug>, /services, …),
  # so Apache hands over the app shell and React resolves it.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Matches the headers render.yaml sets, so both hosts behave alike.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The shell must never be cached. Its asset filenames change every build,
  # and a cached shell would keep asking for files that no longer exist.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Only /assets/ is cached hard, because only those filenames carry a content
# hash. The blanket "image/png for 30 days" rule that used to sit here was
# wrong: it covered the artwork served from the site root — the article sheet,
# the logos, the mascots — and those keep the SAME filename from build to
# build. Replacing one changed the bytes on the server but not the URL, so
# every browser that had already seen it went on showing the old picture for
# a month and never asked for the new one. The artwork now lives in the
# bundle and comes out as /assets/<name>-<hash>.png, so changing a picture
# changes its URL and no cache can hold a stale one.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 10 minutes"
  ExpiresByType image/png               "access plus 10 minutes"
  ExpiresByType image/svg+xml           "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build output: safe to keep forever.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|png|jpe?g|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Anything still served from the root under a fixed name must be revalidated,
  # or replacing it silently does nothing for anyone who has been here before.
  <FilesMatch "^(favicon|favicon-32|apple-touch-icon|icon|placeholder)\.(png|svg)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json image/svg+xml
</IfModule>

AddType image/svg+xml .svg
AddType font/woff2    .woff2
