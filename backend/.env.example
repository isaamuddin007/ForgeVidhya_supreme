# =============================================================================
# forgeVidhya backend/ (Express) — SERVER-SIDE secrets. Copy to backend/.env
# (which is gitignored). NEVER commit real values, and never expose these to
# the browser — only the web/ VITE_-prefixed vars are public.
# =============================================================================

# --- DeepSeek AI assistant (server-side proxy) ---
# Get a key at https://platform.deepseek.com/. The SPA never sees this; the
# backend proxies chat requests so the key stays private.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-chat

# --- Mobile-number (OTP) auth ---
# The single number granted admin. Everyone else is a read-only user.
ADMIN_PHONE=+918008757916
DEFAULT_COUNTRY_CODE=+91

# Twilio SMS delivery. If these are blank, OTPs are printed to the server
# console in development (and refused in production).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Core stack (see DEPLOYMENT.md) — needed for the full server to boot ---
# DATABASE_URL=postgresql://user:pass@host:26257/db?sslmode=verify-full
# JWT_SECRET=change-me-long-random
# CLIENT_ORIGIN=https://forgevidhya.in
# NODE_ENV=development
# PORT=5000
