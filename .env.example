# =============================================================================
# forgeVidhya - Environment variables (backend)
# Copy to `backend/.env` and fill real values. NEVER commit the real .env file.
# Security note: Centralizes all secrets outside source control.
# =============================================================================

# --- Runtime ---
NODE_ENV=production                 # 'development' | 'production'
PORT=5000                           # API port
TRUST_PROXY=1                       # 1 when behind Nginx/Cloudflare/Heroku, else 0

# --- Frontend / CORS ---
CLIENT_ORIGIN=https://forgevidhya.in    # allowed browser origin (whitelist)
CLIENT_URL=http://localhost:8080        # SPA origin the OAuth callback redirects to
COOKIE_DOMAIN=forgevidhya.in            # cookie scope (omit for localhost)

# --- Database: CockroachDB (PostgreSQL wire protocol) ---
# Least-privilege app user (table privileges only, NOT root/admin).
# Get this string from CockroachDB Cloud -> Connect.
DATABASE_URL=postgresql://forgevidhya_app:CHANGE_ME@<host>:26257/forgevidhya?sslmode=verify-full
# DATABASE_CA=./certs/root.crt        # optional CA cert path for verify-full
# PGSSL_DISABLE=1                     # ONLY for a local insecure cluster (dev)

# --- JWT (single 7-day token; generate with: openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES=7d

# --- Session (Passport; generate with: openssl rand -base64 48) ---
SESSION_SECRET=CHANGE_ME_long_random_session_secret

# --- Google OAuth (from Google Cloud Console -> Credentials) ---
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- Uploads ---
UPLOAD_DIR=./uploads                # git-ignored; sketch-to-DWG images

# --- Logging ---
LOG_LEVEL=info                      # error|warn|info|debug
