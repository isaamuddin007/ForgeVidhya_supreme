# =============================================================================
# forgeVidhya - Environment variables (backend)
# Copy to `.env` and fill real values. NEVER commit the real .env file.
# Security note: Centralizes all secrets outside source control.
# =============================================================================

# --- Runtime ---
NODE_ENV=production                 # 'development' | 'production'
PORT=5000                           # API port
TRUST_PROXY=1                       # 1 when behind Nginx/Cloudflare/Heroku, else 0

# --- Frontend / CORS ---
CLIENT_ORIGIN=https://forgevidhya.in   # allowed browser origin (whitelist)
COOKIE_DOMAIN=forgevidhya.in            # cookie scope (omit for localhost)

# --- Database (least-privilege app user, NOT admin/root) ---
# User must have readWrite on the forgevidhya DB only.
MONGO_URI=mongodb+srv://forgevidhya_app:CHANGE_ME@cluster0.mongodb.net/forgevidhya?retryWrites=true&w=majority

# --- JWT secrets (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=CHANGE_ME_long_random_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_different_long_random_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12               # minimum 12

# --- Uploads ---
UPLOAD_DIR=./uploads                # git-ignored; sketch-to-DWG images

# --- Logging ---
LOG_LEVEL=info                      # error|warn|info|debug

# --- Frontend (Vite; place in frontend/.env, prefix VITE_) ---
# VITE_API_URL=https://forgevidhya.in/api
